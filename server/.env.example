# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Database URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/eventhub?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_super_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# College Configuration
COLLEGE_NAME=Apex Institute of Technology
COLLEGE_SHORT_NAME=AIT
COLLEGE_DOMAIN=apex.edu

# Nodemailer / SMTP (Optional: OTP logs to server console if left empty)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@apex.edu

# Cloudinary (For media uploads in future tasks)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
